{% assign product_obj = block.settings.product | default: product %}
{% assign rating_value = product_obj.metafields.sbb_reviews.rating.value | default: 0 %}
{% assign rating_count = product_obj.metafields.sbb_reviews.count.value | default: 0 %}

{% if rating_count > 0 %}
  <div class="sbb-star-rating-wrapper" style="display: inline-flex; align-items: center; gap: 6px; margin: 6px 0; font-size: 14px;">
    <span style="color: {{ block.settings.colour | default: '#ffb800' }}; font-size: 16px;">
      {% assign rounded_rating = rating_value | round %}
      {% for i in (1..5) %}
        {% if i <= rounded_rating %}★{% else %}☆{% endif %}
      {% endfor %}
    </span>
    <span style="color: #555; font-weight: 600;">
      {{ rating_value }} ({{ rating_count }})
    </span>
  </div>
{% endif %}

{% schema %}
{
  "name": "Star Rating",
  "target": "section",
  "settings": [
    { "type": "product", "id": "product", "label": "Product", "autofill": true },
    { "type": "color", "id": "colour", "label": "Star Colour", "default": "#ffb800" }
  ]
}
{% endschema %}